{
  "id": "beemtube-d",
  "kind": "tool",
  "version": "0.6.0",
  "license": "GPL-3.0-or-later",
  "title": "BeeMTube service",
  "description": "The car side of BeeMTube, an unofficial client for YouTube: yt-dlp (from its official release, run in mgu-python) fetches as the daemon's own internet uid; search, feeds and thumbnails on the car (jap-node22); the video is decoded by ytdec into the mgu-render video layer and plays on this service's own clock, so the picture never waits for the sound; on iDrive 8 the sound is asked for by the BeeMTube app (the registered OAP app the car's media services answer) or played by this service itself (ytaud, ytalsa.py), and on iDrive 7 through the BMW MediaPlayer as ever; TV device sign-in; controlled by the BeeMTube app over /run/beemtube-d/ctl.sock. iDrive 7 and iDrive 8",
  "requires": {
    "mgu-deploy": "0.7.0",
    "mgu-python": "1.0.2",
    "jap-node22": "22.23.4",
    "mgu-render": "0.6.11"
  },
  "uninstallable": true,
  "internet": true,
  "uids": "state/internet-uids",
  "mguHmi": [
    "ID7",
    "ID8"
  ],
  "files": [
    {
      "path": "ytd.js",
      "from": "ytd.js",
      "mode": "0644"
    },
    {
      "path": "audio.js",
      "from": "audio.js",
      "mode": "0644"
    },
    {
      "path": "ytdec",
      "from": "build/ytdec",
      "mode": "0755"
    },
    {
      "path": "ytalsa.py",
      "from": "ytalsa.py",
      "mode": "0644"
    },
    {
      "path": "ytaud",
      "from": "build/ytaud",
      "mode": "0755"
    },
    {
      "path": "ytfetch.py",
      "from": "ytfetch.py",
      "mode": "0644"
    },
    {
      "path": "ytdlp.pyz",
      "from": "build/ytdlp.pyz",
      "mode": "0644"
    },
    {
      "path": "thumb.js",
      "from": "thumb.js",
      "mode": "0644"
    },
    {
      "path": "vendor/jpeg-js/decoder.js",
      "from": "vendor/jpeg-js/decoder.js",
      "mode": "0644"
    },
    {
      "path": "vendor/jpeg-js/LICENSE",
      "from": "vendor/jpeg-js/LICENSE",
      "mode": "0644"
    },
    {
      "path": "check.sh",
      "from": "check.sh",
      "mode": "0755"
    },
    {
      "path": "LICENSE",
      "from": "../../LICENSE",
      "mode": "0644"
    },
    {
      "path": "THIRD_PARTY_LICENSES",
      "from": "../../THIRD_PARTY_LICENSES",
      "mode": "0644"
    }
  ],
  "check": [
    "check.sh"
  ],
  "units": [
    {
      "name": "beemtube-d.service",
      "from": "systemd/beemtube-d.service"
    }
  ],
  "enable": [
    {
      "unit": "beemtube-d.service",
      "target": "multi-user.target"
    }
  ],
  "crashNames": [
    "ytdec",
    "ytaud"
  ],
  "recmgr": [
    "beemtube-d"
  ],
  "restart": [
    "beemtube-d.service"
  ]
}
